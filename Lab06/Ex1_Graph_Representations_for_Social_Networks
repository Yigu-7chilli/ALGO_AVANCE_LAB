class SocialGraph:
    def __init__(self):
        self.users = []                     
        self.user_to_index = {}             
        self.index_to_user = {}             
        self.adj_matrix = []                
        self.adj_list = {}                 
        self.num_edges = 0                  

   
    def add_user(self, u):
        if u in self.user_to_index:
            return

        index = len(self.users)
        self.users.append(u)
        self.user_to_index[u] = index
        self.index_to_user[index] = u

        
        for row in self.adj_matrix:
            row.append(0)
        self.adj_matrix.append([0] * (index + 1))

    
        self.adj_list[u] = []

    
    def are_friends(self, u, v):
        if u not in self.user_to_index or v not in self.user_to_index:
            return False

        i = self.user_to_index[u]
        j = self.user_to_index[v]

        return self.adj_matrix[i][j] == 1

    
    
    def add_friendship(self, u, v):
        if self.are_friends(u, v):
            return

        i = self.user_to_index[u]
        j = self.user_to_index[v]

        self.adj_matrix[i][j] = 1
        self.adj_matrix[j][i] = 1

        self.adj_list[u].append(v)
        self.adj_list[v].append(u)

        self.num_edges += 1

    
    
    def remove_friendship(self, u, v):
        if not self.are_friends(u, v):
            return

        i = self.user_to_index[u]
        j = self.user_to_index[v]

        self.adj_matrix[i][j] = 0
        self.adj_matrix[j][i] = 0

        self.adj_list[u].remove(v)
        self.adj_list[v].remove(u)

        self.num_edges -= 1

    
    
    def get_friends(self, u):
        return self.adj_list[u]



    def get_degree(self, u):
        return len(self.adj_list[u])

    def get_num_users(self):
        return len(self.users)

    def get_num_edges(self):
        return self.num_edges

    
    


    def is_complete_graph(self):
        n = len(self.users)

        for i in range(n):
            for j in range(n):
                if i != j:
                    if self.adj_matrix[i][j] == 0:
                        return False
        return True

    def graph_density(self):
        n = len(self.users)
        m = self.num_edges

        if n <= 1:
            return 0

        return (2 * m) / (n * (n - 1))

    def degree_distribution(self):
        dist = {}

        for u in self.users:
            d = len(self.adj_list[u])
            if d not in dist:
                dist[d] = 0
            dist[d] += 1

        return dist

   
   


    def matrix_to_list(self):
        n = len(self.users)

   
   
        for u in self.users:
            self.adj_list[u] = []

        for i in range(n):
            for j in range(n):
                if self.adj_matrix[i][j] == 1:
                    u = self.index_to_user[i]
                    v = self.index_to_user[j]
                    self.adj_list[u].append(v)

    def list_to_matrix(self):
        n = len(self.users)

       
       
        self.adj_matrix = [[0] * n for _ in range(n)]

        for u in self.users:
            i = self.user_to_index[u]
            for v in self.adj_list[u]:
                j = self.user_to_index[v]
                self.adj_matrix[i][j] = 1




